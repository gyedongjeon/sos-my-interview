# Copy to .env and fill in. Needed only for follow-up questions.
#
# LLM_MODEL is "<provider>/<model>" as named by LiteLLM
# (https://docs.litellm.ai/docs/providers), for example:
#   gemini/<model>                -> needs GEMINI_API_KEY
#   openrouter/<vendor>/<model>   -> needs OPENROUTER_API_KEY
#   openai/<model>                -> needs OPENAI_API_KEY
#   anthropic/<model>             -> needs ANTHROPIC_API_KEY
# Set only the key of the provider you chose.
LLM_MODEL=

GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: local Whisper model for transcription (default: small.en).
WHISPER_MODEL=
